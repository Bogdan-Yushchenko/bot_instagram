{
  "name": "ig-saas-bot",
  "version": "1.0.0",
  "description": "Instagram DM bot for SaaS sales to psychologists",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --build",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate",
