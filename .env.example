# ── Instagram account ─────────────────────────────────────────────────────────
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password

# ── Bot content ───────────────────────────────────────────────────────────────
MATERIAL_LINK=https://yoursite.com/free-guide

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5433/ig_saas_bot

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

